{
  "name": "myaie-recording-downloader",
  "version": "1.2.1",
  "private": true,
  "description": "Automates the myAIE student portal: iterates the calendar schedule for a date range and downloads past live lecture recordings using your real Chrome session.",
  "type": "module",
  "scripts": {
    "start": "node myaie-bot.ts",
    "gui": "node gui-server.ts",
    "selftest": "node myaie-bot.ts --selftest",
    "help": "node myaie-bot.ts --help",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke",
    "desktop:build": "electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.49.0"
  },
  "author": "JacyFleisie <jacyreyneke3@gmail.com>",
  "main": "electron/main.ts",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.jacyfleisie.myaie-recording-downloader",
    "productName": "myAIE Lecture Downloader",
    "files": [
      "electron/**/*",
      "public/**/*",
      "bot-core.ts",
      "gui-server.ts",
      "myaie-bot.ts",
      "yt-dlp.exe",
      "package.json",
      "build/icon.png"
    ],
    "asarUnpack": [
      "yt-dlp.exe"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "JacyFleisie",
      "repo": "myaie-recording-downloader",
      "releaseType": "release"
    }
  }
}
